meta {
  name: Chatroom GetByUser
  type: http
  seq: 3
}

get {
  url: {{chat_url}}/chatrooms/user/{{userSeedId}}
  body: none
  auth: inherit
}

body:json {
  {
    "customer_id": {{userSeedId}}
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{chat_url}}/chatrooms/user/{{userSeedId}}
    method: GET
    mode: json
    body:json: {
      {
        "customer_id": {{userSeedId}}
      }
    }
  }
  
  response: {
    headers: {
      date: Fri, 15 May 2026 10:21:34 GMT
      server: uvicorn
      content-length: 75
      content-type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "chatRoomId": "6a06ee2c9488fcc6e405d34b",
            "customerId": 100,
            "staffId": null
          }
        ]
      '''
    }
  }
}
