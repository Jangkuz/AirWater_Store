meta {
  name: Chatroom Create
  type: http
  seq: 1
}

post {
  url: {{chat_url}}/chatrooms
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": {{userSeedId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  const body = res.getBody();
  
  if(body.chatRoom){
    bru.setVar("chatCreatedId", body.chatRoom.chatRoomId)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{chat_url}}/chatrooms
    method: POST
    mode: json
    body:json: {
      {
        "customer_id": {{userSeedId}}
      }
    }
  }
  
  response: {
    headers: {
      date: Fri, 15 May 2026 10:08:51 GMT
      server: uvicorn
      content-length: 86
      content-type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "chatRoom": {
            "chatRoomId": "6a06ee2c9488fcc6e405d34b",
            "customerId": 100,
            "staffId": null
          }
        }
      '''
    }
  }
}
