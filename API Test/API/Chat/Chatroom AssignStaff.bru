meta {
  name: Chatroom AssignStaff
  type: http
  seq: 4
}

post {
  url: {{chat_url}}/chatrooms/{{chatCreatedId}}/assign
  body: json
  auth: inherit
}

body:json {
  {
    "staffId": {{staffSeedId}}
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  
  if(body){
    bru.setVar("chatCreatedId", body.id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
