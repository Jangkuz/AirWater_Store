meta {
  name: User Login
  type: http
  seq: 2
}

post {
  url: {{airwaterstore_url}}/users/login
  body: json
  auth: inherit
}

body:json {
  {
      "Email": "user@gmail.com",
      "Password": "123456As!"
  }
  
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  
  if(body){
    bru.setVar("token", body.token)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{airwaterstore_url}}/users/login
    method: POST
    mode: json
    body:json: {
      {
          "Email": "user@gmail.com",
          "Password": "123456As!"
      }
      
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      date: Sat, 16 May 2026 07:37:41 GMT
      server: Kestrel
      transfer-encoding: chunked
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
