meta {
  name: User GetPaging
  type: http
  seq: 4
}

get {
  url: {{airwaterstore_url}}/users?ExceptUserId=2&PageIndex=1&PageSize=10
  body: none
  auth: inherit
}

params:query {
  ExceptUserId: 2
  PageIndex: 1
  PageSize: 10
}

assert {
  res.status: eq 200
  res.body.users.count: gt 0
}

settings {
  encodeUrl: true
  timeout: 0
}

