meta {
  name: User Create
  type: http
  seq: 1
}

post {
  url: {{airwaterstore_url}}/users
  body: json
  auth: inherit
}

body:json {
  {
      "Username": "duongVDQ",
      "Email": "anhdlse181818@fpt.edu.vn",
      "Password": "12346Qw!"  
  }
}

assert {
  res.status: eq 201
  res.is: isNumber
}

script:post-response {
  const body = res.getBody();
  
  if(body){
    bru.setVar("userCreatedId", body.id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{airwaterstore_url}}/users
    method: POST
    mode: json
    body:json: {
      {
          "Username": "duongVDQ",
          "Email": "anhdlse181818@fpt.edu.vn",
          "Password": "12346Qw!"  
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      date: Fri, 15 May 2026 10:45:51 GMT
      server: Kestrel
      location: /users/5
      transfer-encoding: chunked
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 5
        }
      '''
    }
  }
}
